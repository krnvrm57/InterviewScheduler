<script src="~/Content/js/App/Task/CreateTask.js?v=@DateTime.Now"></script>
<script src="~/Content/js/Common/DragDropUI.js?v=@DateTime.Now"></script>


<script>
    $("[name*='InterviewType']").change(function (e) {
        $("#divInterviewDates").hide("slow");
        $("#divInterviewDetails").show("slow");
        if ($("#InterviewTypeS:checked").val() == "S") {
            // $("#divInterviewDates").show("slow");
        }
    });
    $("#btn_NextDetails").click(function (e) {
        debugger;
        var _form = $("#FormCreateTask");
        if (_form.valid()) {
            debugger;
            if (SaveToDB(true)) {
                $("#divInterviewDetails").hide();
                $("#divInterviewDates").hide();
                if ($("#InterviewTypeS:checked").val() == "S") {
                    $("#divInterviewDates").show("slow");
                }
                else {
                    $("#divCandidateDetails").show("slow");
                }
            }
        }
    });

    $("#btn_NextDetails1").click(function (e) {
        var _form = $("#FormCreateTask");
        if (_form.valid()) {
            debugger;
            if(SaveToDB(true)){
                $("#divInterviewDetails").hide();
                $("#divInterviewDates").hide();
                if ($("#InterviewTypeS:checked").val() == "S") {
                    $("#divInterviewDates").show("slow");
                }
                else {
                    $("#divCandidateDetails").show("slow");
                }
            }
        }
    });

    $("#btn_NextDetails2").click(function (e) {
        var _form = $("#FormCreateTask");
        if (_form.valid()) {
            debugger;
            if (SaveToDB(true)) {
                $("#divInterviewDetails").hide();
                $("#divInterviewDates").hide();
                $("#divCandidateDetails").show("slow");
            }
        }
    });
</script>