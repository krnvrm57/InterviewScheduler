@model InterviewScheduler.Models.TaskModel
@{
    ViewBag.Title = "View Schedule Interview";
}

@{
    var disableAttr = !Model.AllowEdit ? "disabled=\"disabled\"" : "";
    <div id="dialog" class="modal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog custom-modal   modal-lg" role="document">
            <div class="modal-content modal-xl">
                <div class="modal-header">
                    <div class="modal-title">
                        Redirect or Assign task sheduled for interview
                        <div class="modal-tools">
                            <i id="expandcollaps" class="fa fa-expand"></i>
                            <i type="button" class="fa fa-close" data-dismiss="modal" aria-hidden="true" aria-label="Close">
                            </i>
                        </div>
                    </div>
                </div>

                <div class="modal-body" style="">
                    <form id="FormViewDetails" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-sm-12">
                                <label class="col-label"><b>@Model.Title</b> on <b>@Model.InterviewSlot1Date.ToString("dd/MMM/yyyy")</b> from <b>@Model.InterviewSlot1StartTime</b> to <b>@Model.InterviewSlot1StartTime</b> </label>
                            </div>
                            <div class="col-sm-12">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <label class="form-label required" for="event-topic">Select on option to Redirect or Assign task sheduled for interview. </label><br />
                                    <div class="mb-1 form-check">
                                        <input class="form-check-input" id="TransferR" type="radio" name="Transfer" value="Male" @(Model.CandidateProfileModel.CandidateGender == "Male" ? "checked" : "") @disableAttr>
                                        <label class="form-label mb-0" for="TransferR">Redirect</label>
                                    </div>
                                    <div class="mb-1 form-check">
                                        <input class="form-check-input" id="TransferA" type="radio" name="Transfer" value="Female" @(Model.CandidateProfileModel.CandidateGender == "Female" ? "checked" : "") @disableAttr>
                                        <label class="form-label mb-0" for="TransferA">Assign</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row form-group-inner" id="sectionAssign">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <select>
                                        <option></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row form-group-inner" id="sectionRedirect">
                            <div class="col-sm-12">
                                <div class="form-group">
                                    <select>
                                        @foreach (var item in Model.Action) {
                                        <option>  @item.StartDescription_EN</option>
                                        }
                                    </select>
                                </div>

                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer" style="background:white;">
                    <div class="text-left d-none">
                        <b>
                            <a id="tips" href="#">
                                Tips <i class="fa fa-info-circle text-right auto-width"> </i>
                            </a>
                        </b>
                    </div>
                    <div class="text-right">
                        @if (Model.AllowAction)
                        {
                            <div class="col-lg-12">
                                <a class="btn btn-secondary" id="btnSubmit">Update Details</a>
                            </div>
                        }
                        @*@if (Model.AllowAction)
                            {
                                <div class="col-lg-12 mt-3">
                                    <a class="btn btn-secondary" id="btnSubmit">Submit</a>
                                </div>
                            }*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.Hidden("Id", Model.Id)
    @Html.Hidden("AllowEdit", Model.AllowEdit)
    @Html.Hidden("JsonSkills", Html.Raw(Json.Encode(Model.Skills)));

}

@*<script src="~/Content/js/App/Task/CreateTask.js?v=@DateTime.Now"></script>*@
<script src="~/Content/js/Common/DragDropUI.js?v=@DateTime.Now"></script>
<script>
</script>

<script>

    $(document).ready(function () {


        $("body").on("click", "#btnSubmit", function (e) {
            debugger;
            var formData = {
                Id: $("#Id").val(),
                TaskAction: $("#TaskAction").val(),
                ScheduleOn: $("#ScheduleOn").val(),
                Comments: $("#Comments").val(),
                InterviewRound: $("#InterviewRound").val() == "" ? "00000000-0000-0000-0000-000000000000" : $("#InterviewRound").val(),
                AssignedToPanel: $("#AssignedToPanel").val() == "" ? "00000000-0000-0000-0000-000000000000" : $("#AssignedToPanel").val(),
                InterviewerRequired: $("#InterviewerRequired").val() == "" ? 0 : $("#InterviewerRequired").val(),
            };
            var _form = $("#FormViewDetails");
            if (_form.valid()) {
                $.ajax({
                    type: "POST",
                    url: '/Task/SubmitTask',
                    data: formData,
                    dataType: "json",
                    beforeSend: function (jqXHR, settings) {
                        $("#spinner").fadeIn("slow");
                    },
                    success: function (response) {
                        try {
                            var resultdata = JSON.parse(response)
                            if (resultdata.Status == Status.Unauthrizedcode) {
                                window.location.href = url.LoginPageUrl
                            }

                        }
                        catch (err) { }
                        window.location.href = "/Task";

                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    },
                    complete: function (jqXHR, textStatus) {
                        if (completeFunction && (typeof completeFunction == "function")) {

                        };
                        $("#spinner").fadeOut("slow");
                    },
                });
            }
        })
        $("body").on("change", "#TaskAction", function (e) {
            debugger;
            $("#ScheduleSection").hide();
            $("#CommentSection").hide();
            $("#AssignSection").hide();
            $("#ScheduleOn").val("");
            $("#Comments").val("");
            $("#InterviewRound").closest(".form-group").children("label").removeClass("required");
            $("#InterviewRound").closest(".form-group").children("select").attr("disabled", "disabled");

            if ($(this).val() !== "") {
                if ($(this).val() == "800") {
                    $("#ScheduleSection").show();
                }
                else if ($(this).val() == "200") {
                    $("#AssignSection").show();
                    $("#InterviewRound").closest(".form-group").children("label").addClass("required");
                    $("#InterviewRound").closest(".form-group").children("select").removeAttr("disabled");


                }
                $("#CommentSection").show();
            }
        });
        $("body").on("click", ".DownloadFile", function (e) {
            var DocumentId = $(this)[0].id;
            var url = "/common/DownloadDocument?DocumentId=" + DocumentId;
            window.location.href = url;
        });

        var elt = $("#SkillsRequired");

        elt.tagComplete({
            PreAddedTag: JSON.parse($("#JsonSkills").val()) != undefined ? JSON.parse($("#JsonSkills").val()) : '',
            itemKey: "Id",
            itemValue: "Skill",
            keyLimit: 2,
            freeInput: false,
            hide: false,
            autocomplete: {
                // ajax options
                ajaxOpts: {
                    url: '/Common/GetSkills?RequestString=' + $(".tag_input").val(),
                    method: 'GET',
                    dataType: 'json',
                    // data: { RequestString: $(".tag_input").val() },
                    success: function (_data) {
                        // not sure if i should return the data here on at end of the ajax call definition
                        return _data;
                    },
                },

            },
            ShowTemplate: function (data) {
                return data.SKill;
            },
            template: function (data) {
                return data.SKill;
            },
        });


        $("#SkillsRequired").siblings(".tag_complete_main").find(".tag_input").wrap('<div class="input-group-append"></div>');
        $('<span class="input-group-text"><i class="fa fa-file" data-toggle="tooltip" data-placement="top" title="Please enter fullname or atleaset  two char to select Skill"></i></label></span>').insertAfter($("#SkillsRequired").siblings(".tag_complete_main").find(".tag_input"));

    });
</script>


@if (!Model.AllowAction)
{
    <script>
        $(document).ready(function () {

            $("#SkillsRequired").siblings(".tag_complete_main").find(".input-group-append").hide();
            $(".tag .close").hide();
        });


    </script>
}
else
{
    <script>
        $(".fileclose").click(function (e) {

            $(this).closest("#downloadfile").hide();

            $(this).closest("#downloadfile").siblings("#divdropzone").show();

        });


    </script>
}